# Example environment variables (do not commit secrets)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.x2eg2.mongodb.net/?appName=Cluster0
EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY
EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID
RECEIVER_EMAIL=your-email@example.com

# Vite-exposed variables (client-side). Prefix with VITE_ so they are available in the browser.
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY
VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID
VITE_RECEIVER_EMAIL=your-email@example.com
VITE_OPENAI_API_KEY=YOUR_OPENAI_API_KEY
VITE_OPENAI_MODEL=gpt-4.1-mini
